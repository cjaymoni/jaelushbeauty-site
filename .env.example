# Copy to .env.local (never commit real values).

# API key from https://resend.com/api-keys. Without it, orders are only
# printed to the terminal in development and rejected in production.
RESEND_API_KEY=

# Inbox that receives new orders.
ORDER_EMAIL_TO=

# Sender shown on order emails. The domain must be verified in Resend.
# Defaults to "Jaelush Beauty <orders@jaelushbeauty.com>".
ORDER_EMAIL_FROM=

# Optional: Upstash Redis (https://upstash.com) so the order rate limit is
# shared by every server instance. Without these it is kept per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
